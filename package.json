{
    "name": "legcord",
    "version": "1.3.0",
    "description": "Legcord is a custom client designed to enhance your Discord experience while keeping everything lightweight.",
    "main": "ts-out/main.js",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "build:dev": "rollup -c --environment BUILD:dev && node --experimental-strip-types scripts/copyVenmic.ts",
        "build:plugins": "lune ci --repoSubDir src/shelter --to ts-out/plugins",
        "build": "pnpm build:plugins && rolldown -c rolldown.config.ts && node --experimental-strip-types scripts/copyVenmic.ts",
        "start": "pnpm run build && electron --trace-warnings --ozone-platform-hint=auto ./ts-out/main.js",
        "startThemeManager": "pnpm run build:dev && electron ./ts-out/main.js themes",
        "package": "pnpm run build && electron-builder",
        "packageQuick": "pnpm run build && electron-builder --dir",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "test": "node --experimental-strip-types --import ./tests/register-ts.mjs --test tests/screenshare-previews.test.ts",
        "postinstall": "electron-builder install-app-deps",
        "CIbuild": "pnpm run build && electron-builder --linux zip && electron-builder --windows zip && electron-builder --macos zip",
        "updateMeta": "node --experimental-strip-types scripts/utils/updateMeta.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Legcord/Legcord.git"
    },
    "author": "smartfrigde",
    "license": "OSL-3.0",
    "type": "module",
    "bugs": {
        "url": "https://github.com/Legcord/Legcord/issues"
    },
    "homepage": "https://github.com/Legcord/Legcord#readme",
    "devDependencies": {
        "@biomejs/biome": "2.5.5",
        "@rolldown-plugin/solid": "^0.1.0",
        "@rollup/plugin-esm-shim": "^0.1.8",
        "@types/adm-zip": "^0.5.8",
        "@types/node": "^26.1.1",
        "@types/ws": "^8.18.1",
        "@uwu/lune": "^1.6.3",
        "@uwu/shelter-defs": "^1.5.1",
        "@uwu/shelter-ui": "^0.0.6",
        "@xmldom/xmldom": "^0.9.10",
        "app-builder-lib": "^26.15.3",
        "babel-preset-solid": "^1.9.12",
        "electron": "44.2.0",
        "electron-builder": "26.15.7",
        "lucide-solid": "^1.26.0",
        "monaco-editor": "0.56.0",
        "rolldown": "1.2.7",
        "rollup-plugin-copy": "^3.5.0",
        "solid-js": "^1.9.14",
        "solid-motionone": "^1.0.4",
        "spdx-license-list": "^6.11.0",
        "typescript": "^7.0.2",
        "xml-formatter": "^3.7.0"
    },
    "dependencies": {
        "@jellybrick/dbus-next": "^0.11.1",
        "adm-zip": "^0.6.0",
        "arrpc": "github:Legcord/arrpc#efe7589762470d32b9ba10d529be5acc23cd0e19",
        "electron-context-menu": "^4.1.2",
        "electron-is-dev": "^3.0.1",
        "electron-updater": "^6.8.9",
        "ms": "^2.1.3",
        "spitroast": "^2.1.6",
        "tslib": "^2.8.1",
        "ws": "^8.21.1"
    },
    "optionalDependencies": {
        "@vencord/venmic": "^7.1.0"
    },
    "packageManager": "pnpm@11.10.0",
    "package-manager-strict": false
}
